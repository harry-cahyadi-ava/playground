{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GraphQL": {
    "Pagination": {
      "DefaultPageSize": 20,
      "MaxPageSize": 100
    },
    "Authorization": {
      "Enabled": true,
      "Authority": "https://identity.internal.example.com",
      "Issuer": "https://identity.internal.example.com",
      "Audience": "customer-services",
      "RequireHttpsMetadata": true,
      "RoleClaimType": "roles",
      "RequiredRoles": []
    }
  },
  "AllowedHosts": "*"
}
